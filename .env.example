# Required: MySQL/TiDB connection string (drizzle dialect: mysql)
# Local example: mysql://root:password@localhost:3306/buildscope
DATABASE_URL=

# Required in production: HMAC secret used to sign session JWT cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: enables OAuth login flow. Without it the CRM demo stays public.
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Optional: LLM gateway for AI lead qualification.
# Without it leads with notes fall back to rule-based qualification.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Server port (defaults to 3000; Railway injects PORT automatically)
PORT=
